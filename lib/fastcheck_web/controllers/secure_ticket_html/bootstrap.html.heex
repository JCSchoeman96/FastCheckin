<Layouts.app flash={@flash}>
  <div id="secure-ticket-bootstrap" class="mx-auto max-w-md px-4 py-16 text-center">
    <p id="secure-ticket-bootstrap-status" class="text-lg text-base-content">
      Opening your ticket…
    </p>
    <p id="secure-ticket-bootstrap-error" class="mt-4 hidden text-sm text-error" hidden>
      We could not open your ticket. Please use the link from your message or contact support.
    </p>
  </div>
</Layouts.app>
