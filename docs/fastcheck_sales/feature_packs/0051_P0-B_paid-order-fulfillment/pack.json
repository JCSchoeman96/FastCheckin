    "docs/fastcheck_sales/feature_packs/0051_P0-B_paid-order-fulfillment/pack.json"
  ],
  "payment_handoff": {
    "worker": "FastCheck.Workers.PaidOrderFulfillmentWorker",
    "queue": "sales_inventory",
    "authoritative_arg": "payment_attempt_id",
    "payment_state_and_job_insert": "same Postgres transaction"
  },
  "inventory": {
    "coordinator": "FastCheck.Sales.PaidOrderFulfillment",
    "consume_key": "paid_order_fulfillment:consume:<payment_attempt_id>",
