# Production environment template. Use a secret manager or an untracked local
# env file for real values; do not commit secrets. Workstation DEV/TEST use
# `.env.development.example` and `.env.test.example` instead.
MIX_ENV=prod
SECRET_KEY_BASE=replace-with-output-from-mix-phx-gen-secret
ENCRYPTION_KEY=replace-with-output-from-mix-phx-gen-secret
MOBILE_JWT_SECRET=replace-with-output-from-mix-phx-gen-secret
SALES_HOLD_TOKEN_PEPPER=replace-with-output-from-mix-phx-gen-secret
TICKET_TOKEN_PEPPER=replace-with-output-from-mix-phx-gen-secret
DATABASE_URL=ecto://fastcheck:replace-with-secret@db.example.net:5432/fastcheck_prod
MIGRATION_DATABASE_URL=ecto://fastcheck_migrator:replace-with-secret@db.example.net:5432/fastcheck_prod
REDIS_URL=redis://redis.example.net:6379
# DATABASE_POOLING_MODE controls whether the shared Repo talks directly to Postgres
# or through PgBouncer. Valid values: direct, pgbouncer_transaction, pgbouncer_session
DATABASE_POOLING_MODE=direct
# Start with unnamed prepares for PgBouncer transaction pooling unless your
# PgBouncer/Postgrex/Ecto combination is explicitly verified safe otherwise.
# DB_PREPARE_MODE=unnamed
# OBAN_NOTIFIER defaults to pg for pgbouncer_transaction and postgres otherwise.
# Set pg only after verifying notifier/cluster behavior in the deployed topology.
# OBAN_NOTIFIER=pg
# Keep migrations on direct Postgres when DATABASE_URL points at PgBouncer.
DEFAULT_TICKERA_SITE_URL=https://voelgoed.co.za
DOMAIN=your-domain.com
PORT=8080
ENABLE_HTTPS=false
# HTTPS_PORT defaults to 443 when ENABLE_HTTPS=true

# Optional tuning knobs
PHX_SERVER=true
POOL_SIZE=20
ECTO_IPV6=false
# Payment enforcement policy: keep false for strict mode.
# Set true only as a temporary fallback if Tickera omits payment status.
ALLOW_UNKNOWN_PAYMENT_STATUS=false

# TLS configuration. Defaults match Let's Encrypt paths but can be pointed
# elsewhere when using a different certificate authority.
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Set unique dashboard credentials through a secret manager.
DASHBOARD_USERNAME=<set-via-secret-manager>
DASHBOARD_PASSWORD=<set-via-secret-manager>

# Uncomment to enable distributed clustering via DNS on Fly.io/Kubernetes.
# DNS_CLUSTER_QUERY=_fastcheck._tcp.your-domain.internal

PAYSTACK_ENABLED=false
PAYSTACK_ENVIRONMENT=test
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_TIMEOUT_MS=10000
PAYSTACK_ALLOWED_CHANNELS=card,bank,bank_transfer,eft,capitec_pay
PAYSTACK_CALLBACK_URL=https://scan.voelgoed.co.za/sales/payments/paystack/callback
PAYSTACK_WEBHOOK_URL=https://scan.voelgoed.co.za/api/sales/paystack/webhook
